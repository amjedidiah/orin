# Meta Model API
META_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=
# muse-spark-1.3-contributor: cheaper, data may be used by Meta. Use it for development and the
# public demo (synthetic data only). Use muse-spark-1.3 (Standard) wherever real data is involved.
ROUTER_MODEL=muse-spark-1.3-contributor
# minimal | low | medium | high. Minimal keeps routing fast and cheap.
ROUTER_REASONING_EFFORT=minimal
IMAGE_MODEL=muse-image-1.0

# Muse Spark Open hosts, tried in OPEN_WEIGHTS_ORDER (use the hackathon model ID, not the one in
# Baseten's docs)
OPEN_WEIGHTS_ORDER=baseten,modal
BASETEN_BASE_URL=
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026
MODAL_BASE_URL=
MODAL_API_KEY=
MODAL_MODEL=meta-models/muse-spark-open-1026

# Fallback chain: "spark" = best fit → Muse Spark → Muse Spark Open; "free" = best fit → Muse Spark Open
ORIN_ROUTE_FALLBACK=spark

# Bring your own key: any OpenAI-compatible vendor API (optional, not wired up yet)
BYOK_BASE_URL=
BYOK_API_KEY=
BYOK_MODEL=

# Protects the web UI and API on a hosted instance
ORIN_OWNER_TOKEN=
# Where the SQLite database and generated images are stored
ORIN_DATA_DIR=data
