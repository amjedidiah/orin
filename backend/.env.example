# Meta Model API
META_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=
# muse-spark-1.3-contributor: cheaper, data may be used by Meta. Use it for development and the
# public demo (synthetic data only). Use muse-spark-1.3 (Standard) wherever real data is involved.
ROUTER_MODEL=muse-spark-1.3-contributor

# Muse Spark Open on Baseten (use the hackathon model ID, not the one in Baseten's docs)
BASETEN_BASE_URL=
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Bring your own key: any OpenAI-compatible vendor API (optional)
BYOK_BASE_URL=
BYOK_API_KEY=
BYOK_MODEL=

# Protects the web UI and API on a hosted instance
ORIN_OWNER_TOKEN=
